# PostgreSQL
POSTGRES_USER=aifinance
POSTGRES_PASSWORD=aifinance_dev
POSTGRES_DB=aifinance
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# Data Lake
DATA_LAKE_PATH=/app/data/raw

# Binance (no API key needed for public data)
BINANCE_RATE_LIMIT_MS=100

# CoinGecko
COINGECKO_API_KEY=

# Scheduler
SCHEDULER_ENABLED=true

# App
LOG_LEVEL=INFO
POSITION_SIZE_IDR=1000000

# Next.js
DATABASE_URL=postgresql://aifinance:aifinance_dev@postgres:5432/aifinance

# Scanners
# Gate when BTC regime is against the direction (short: BTC bullish; long: BTC bearish).
# Default ON (matches backtest). Set to "false" to fire signals regardless of regime
# — useful for paper A/B testing. Both signal tables record the regime state at signal time
# in regime_allowed, so you can measure which mode performs better post-hoc.
REGIME_FILTER_ENABLED=true
